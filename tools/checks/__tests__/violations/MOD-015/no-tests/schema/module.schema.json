{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "description",
    "version",
    "category",
    "icon",
    "entry",
    "authors",
    "requires",
    "optional"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}[a-z0-9]$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 80
    },
    "version": {
      "type": "string"
    },
    "category": {
      "enum": [
        "classroom",
        "file",
        "image",
        "document",
        "utility"
      ]
    },
    "icon": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "github": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "optional": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "keepAlive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
