{
  "identifier": "capture-overlay",
  "windows": [
    "capture-overlay-*",
    "capture-toolbar-*"
  ],
  "local": false,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-overlay-ui-state",
    "allow-overlay-ui-action"
  ]
}