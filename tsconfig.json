{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": [
    "tools/**/*",
    "fixtures/**/*",
    "packages/*/src/generated/**/*",
    "apps/desktop/src/generated/**/*",
    "eslint.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["tools/checks/__tests__/violations/**", "node_modules"]
}
