{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-overlay",
  "description": "Approved fixed local capture UI only; no module bridge or frontend OS plugin access.",
  "windows": ["capture-overlay-*", "capture-toolbar-*"],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "allow-overlay-ui-state",
    "allow-overlay-ui-action"
  ]
}